   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# AI_EIARI4A_2026: Lab 0 - Baseline Transformer Internals\n",
    "## 1 Million Parameter Causal Transformer (VUT Prospectus Fine-Tuning)\n",
    "\n",
    "**Objective:** Build a generative Transformer with **Top-K Sampling** to prevent repetition and learn VUT Prospectus facts."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Setup and Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf\n",
    "from tensorflow.keras import layers\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import time\n",
    "\n",
    "print(\"TensorFlow version:\", tf.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. Building the Causal Transformer Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_causal_transformer(vocab_size, seq_len=128, embed_dim=128, num_heads=4, ff_dim=512):\n",
    "    inputs = layers.Input(shape=(seq_len,))\n",
    "    x = layers.Embedding(input_dim=vocab_size, output_dim=embed_dim)(inputs)\n",
    "    for i in range(2):\n",
    "        attention_output = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads, key_dim=embed_dim, name=f\"mha_{i}\"\n",
    "        )(x, x, use_causal_mask=True)\n",
    "        x = layers.LayerNormalization(epsilon=1e-6)(x + attention_output)\n",
    "        ffn_output = layers.Dense(ff_dim, activation=\"relu\")(x)\n",
    "        ffn_output = layers.Dense(embed_dim)(ffn_output)\n",
    "        x = layers.LayerNormalization(epsilon=1e-6)(x + ffn_output)\n",
    "    outputs = layers.Dense(vocab_size, activation=\"softmax\")(x)\n",
    "    return tf.keras.Model(inputs=inputs, outputs=outputs)\n",
    "\n",
    "vocab_size = 5000 \n",
    "model = build_causal_transformer(vocab_size=vocab_size)\n",
    "model.compile(optimizer=\"adam\", loss=\"sparse_categorical_crossentropy\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3. Data Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "with open(\"vut_prospectus_text.txt\", 'r', encoding='utf-8') as f: text = f.read()\n",
    "\n",
    "vectorize_layer = tf.keras.layers.TextVectorization(\n",
    "    max_tokens=vocab_size, output_mode='int', output_sequence_length=129\n",
    ")\n",
    "\n",
    "text_chunks = [text[i : i + 500] for i in range(0, len(text) - 500, 100)]\n",
    "\n",
    "def prepare_dataset(texts, batch_size=32):\n",
    "    ds = tf.data.Dataset.from_tensor_slices(texts)\n",
    "    vectorize_layer.adapt(ds.batch(64))\n",
    "    def split_input_target(chunk): return chunk[:, :-1], chunk[:, 1:]\n",
    "    # Shuffle is key to prevent local bias (repetition)\n",
    "    return ds.shuffle(1000).batch(batch_size).map(vectorize_layer).map(split_input_target).prefetch(tf.data.AUTOTUNE)\n",
    "\n",
    "dataset = prepare_dataset(text_chunks)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4. Training (Step 4)\n",
    "Train for 30 epochs for the best \"memory\" of the prospectus."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model.fit(dataset, epochs=30)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5. Interactive Chatbot (Anti-Repetition Version)\n",
    "This version uses **Temperature** and **Top-K Sampling** to prevent the model from getting stuck in loops."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def generate_response(prompt, length=40, temperature=0.7, top_k=5, seq_len=128):\n",
    "    tokens = vectorize_layer([prompt])\n",
    "    if tokens.shape[1] > seq_len: tokens = tokens[:, -seq_len:]\n",
    "    else:\n",
    "        pad = np.zeros((1, seq_len - tokens.shape[1]), dtype=np.int32)\n",
    "        tokens = tf.convert_to_tensor(np.concatenate([pad, tokens.numpy()], axis=1), dtype=tf.int32)\n",
    "        \n",
    "    vocab = vectorize_layer.get_vocabulary()\n",
    "    result = prompt\n",
    "    \n",
    "    for _ in range(length):\n",
    "        preds = model.predict(tokens, verbose=0)[0, -1, :]\n",
    "        # 1. Apply Temperature\n",
    "        preds = np.log(preds + 1e-10) / temperature\n",
    "        exp_preds = np.exp(preds)\n",
    "        preds = exp_preds / np.sum(exp_preds)\n",
    "        \n",
    "        # 2. Top-K Sampling to prevent nonsense\n",
    "        top_indices = np.argsort(preds)[-top_k:]\n",
    "        top_probs = preds[top_indices]\n",
    "        top_probs = top_probs / np.sum(top_probs)\n",
    "        next_id = np.random.choice(top_indices, p=top_probs)\n",
    "        \n",
    "        tokens_np = np.roll(tokens.numpy(), -1, axis=1)\n",
    "        tokens_np[0, -1] = next_id\n",
    "        tokens = tf.convert_to_tensor(tokens_np, dtype=tf.int32)\n",
    "        \n",
    "        word = vocab[next_id]\n",
    "        if word == \"\": break\n",
    "        result += \" \" + word\n",
    "    return result\n",
    "\n",
    "chat_history = []\n",
    "output_area = widgets.Output(layout={'border': '1px solid #ccc', 'height': '400px', 'overflow_y': 'scroll'})\n",
    "input_box = widgets.Text(placeholder='Start a sentence...', layout={'width': '80%'})\n",
    "send_btn = widgets.Button(description='Send', button_style='info')\n",
    "\n",
    "def render():\n",
    "    with output_area:\n",
    "        clear_output()\n",
    "        for speaker, text in chat_history:\n",
    "            bg = \"#f0f0f0\" if speaker == \"You\" else \"#e3f2fd\"\n",
    "            display(HTML(f\"<div style='margin-bottom:10px; padding:10px; background:{bg}; border-radius:10px;'><b>{speaker}:</b> {text}</div>\"))\n",
    "\n",
    "def on_send(b):\n",
    "    text = input_box.value\n",
    "    if not text: return\n",
    "    \n",
    "    # Disable button to prevent double-click\n",
    "    send_btn.disabled = True\n",
    "    input_box.value = ''\n",
    "    \n",
    "    chat_history.append((\"You\", text))\n",
    "    render()\n",
    "    \n",
    "    res = generate_response(text)\n",
    "    chat_history.append((\"VUT-Bot\", res))\n",
    "    render()\n",
    "    \n",
    "    send_btn.disabled = False\n",
    "    input_box.focus()\n",
    "\n",
    "send_btn.on_click(on_send)\n",
    "display(HTML(\"<h3 style='color:#002F6E'>VUT Prospectus Chatbot (v2)</h3>\"))\n",
    "display(output_area, widgets.HBox([input_box, send_btn]))"
   ]
  }
 ],
